# Development proxy target. Match server/.env if the API port changes.
API_PROXY_TARGET=http://127.0.0.1:3001

# Browser key for Maps JavaScript API and Places API (New). Restrict by website referrer.
VITE_GOOGLE_MAPS_API_KEY=

# JavaScript map ID for advanced markers. Defaults to Google's demo map ID locally.
VITE_GOOGLE_MAP_ID=

# Enable sampled-point markers. Off by default.
VITE_ROUTE_DEBUG=false
