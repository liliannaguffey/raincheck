HOST=127.0.0.1
PORT=3001

# Server-restricted key for Routes API and Time Zone API.
GOOGLE_MAPS_SERVER_API_KEY=

# OpenWeather 5 Day / 3 Hour Forecast. Keep this key on the server.
OPENWEATHER_API_KEY=

# Forecast cache lifetime in seconds (0 disables storage).
WEATHER_CACHE_TTL_SECONDS=600

# Configure during the saved trips phase.
DATABASE_URL=
